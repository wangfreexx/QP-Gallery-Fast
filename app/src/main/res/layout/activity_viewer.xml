<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/viewerLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/topChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/viewerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/viewerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hdrBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/hdr_badge"
                android:textColor="@color/hdr_gold"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_pill_dark"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="8dp"
                android:paddingTop="3dp"
                android:paddingRight="8dp"
                android:paddingBottom="3dp"
                android:text="@string/live_badge"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/export_more"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="42dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/gifPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_control_panel"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/frameCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/frameSlider"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="1"
                app:haloColor="@color/accent"
                app:labelBehavior="gone"
                app:thumbColor="@color/accent"
                app:trackColorActive="@color/accent"
                app:trackColorInactive="@color/surface_higher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/gifPrev"
                    style="@style/Widget.SwiftPic.ViewerButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/gif_prev_frame"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/gifPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/bg_pill_dark"
                    android:contentDescription="@string/gif_pause"
                    android:padding="14dp"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/gifNext"
                    style="@style/Widget.SwiftPic.ViewerButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/gif_next_frame"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/gifFramesButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_frames"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/gifFramesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/gif_controls_entry"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/liveButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/liveIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_live"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/liveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/live_badge"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/liveSpinner"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="6dp"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/liveMuteButton"
                style="@style/Widget.SwiftPic.ViewerButton"
                android:layout_marginLeft="2dp"
                android:contentDescription="@string/live_mute"
                android:src="@drawable/ic_volume"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hdrButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/hdrLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/hdr_switch_on"
                    android:textColor="@color/hdr_gold"
                    android:textSize="11sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/editButton"
                style="@style/Widget.SwiftPic.ViewerButton"
                android:contentDescription="@string/edit"
                android:src="@drawable/ic_edit" />

            <ImageButton
                android:id="@+id/favoriteButton"
                style="@style/Widget.SwiftPic.ViewerButton"
                android:contentDescription="@string/favorite"
                android:src="@drawable/ic_star_border" />

            <ImageButton
                android:id="@+id/shareButton"
                style="@style/Widget.SwiftPic.ViewerButton"
                android:contentDescription="@string/share"
                android:src="@drawable/ic_share" />

            <ImageButton
                android:id="@+id/deleteButton"
                style="@style/Widget.SwiftPic.ViewerButton"
                android:contentDescription="@string/delete"
                android:src="@drawable/ic_delete" />

            <ImageButton
                android:id="@+id/detailsButton"
                style="@style/Widget.SwiftPic.ViewerButton"
                android:contentDescription="@string/details"
                android:src="@drawable/ic_info" />
        </LinearLayout>

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>
