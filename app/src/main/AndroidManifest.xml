<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- targetSdk 32: READ_EXTERNAL_STORAGE is what MediaStore and WallpaperManager use.
         Declaring the granular READ_MEDIA_* permissions here makes MIUI's wallpaper
         check fail with "Op READ_MEDIA_IMAGES ignore", so they are intentionally absent. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Only needed on API 28, where MediaStore inserts still go through DATA + direct file writes. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:name=".SwiftPicApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher_flat"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@drawable/ic_launcher_flat"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwiftPic">

        <activity
            android:name=".ui.PickActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:alwaysRetainTaskState="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AlbumActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DestinationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false" />

        <!-- Only entry point reachable from other apps. It validates the URI and
             forwards to the non-exported ViewerActivity; it never renders the library. -->
        <activity
            android:name=".ui.viewer.ExternalViewerActivity"
            android:exported="true"
            android:theme="@style/Theme.SwiftPic.Viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.viewer.ViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.SwiftPic.Viewer" />

        <activity
            android:name=".ui.edit.EditActivity"
            android:exported="false"
            android:theme="@style/Theme.SwiftPic.Viewer" />

        <activity
            android:name=".ui.WallpaperCropActivity"
            android:exported="false"
            android:theme="@style/Theme.SwiftPic.Viewer" />
    </application>

</manifest>
